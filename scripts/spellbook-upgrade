#!/bin/sh
# spellbook-upgrade — the ONLY privileged action the agent user may run as root.
#
# Installed root:root 0755 at /usr/local/bin/spellbook-upgrade; the sudoers
# entry created by install.sh allows the agent user NOPASSWD for exactly
# this path. Trust anchors:
#   1. install.sh verifies the release tarball (sha256 + GPG release-key
#      signature) before installing anything — the agent can only ever
#      install maintainer-signed code, never arbitrary code.
#   2. This wrapper accepts exactly one argument, a strict X.Y.Z release
#      tag. No --from-dir (unsigned), no extra flags, no downgrades: the
#      installed VERSION is compared and older-or-equal tags are refused.
#      Downgrades are the human's call via install.sh run directly as root.
#
# Usage: spellbook-upgrade 0.2.0
set -eu

PREFIX="/opt/spellbook"
INSTALLER="${PREFIX}/lib/install.sh"
VERSION_FILE="${PREFIX}/VERSION"
ENV_FILE="${PREFIX}/install.env"

die() { echo "spellbook-upgrade: FATAL: $*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || die "run via sudo (the sudoers entry allows the agent user NOPASSWD)"
[ "$#" = "1" ] || die "usage: spellbook-upgrade <tag>  (exactly one X.Y.Z tag)"
TAG="$1"
case "$TAG" in
  ""|*[!0-9.]*|*..*|.*|*.) die "bad tag ${TAG} — want X.Y.Z" ;;
esac
# strict X.Y.Z: three numeric components
case "$TAG" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) die "bad tag ${TAG} — want X.Y.Z" ;;
esac
n_dots=$(printf '%s' "$TAG" | tr -cd '.' | wc -c)
[ "$n_dots" = "2" ] || die "bad tag ${TAG} — want X.Y.Z"

[ -f "$VERSION_FILE" ] || die "$VERSION_FILE missing — not installed or record corrupted; human-driven reinstall needed"
INSTALLED="$(cat "$VERSION_FILE")"
# Forward-only for the agent: reinstalling the same signed tag is allowed
# (repair); anything older is refused. Downgrades are the human's call via
# install.sh run directly as root.
if [ "$INSTALLED" != "$TAG" ]; then
  older="$(printf '%s\n%s\n' "$INSTALLED" "$TAG" | sort -V | head -1)"
  [ "$older" = "$INSTALLED" ] \
    || die "refusing: installed is ${INSTALLED}, requested ${TAG} (agent upgrades move forward only; downgrades are the human's call)"
fi

[ -f "$INSTALLER" ] || die "$INSTALLER missing — installer copy lost; human-driven reinstall needed"
[ -f "$ENV_FILE" ] || die "$ENV_FILE missing — install record lost; human-driven reinstall needed"

# shellcheck disable=SC1090
. "$ENV_FILE"   # root-owned, agent cannot tamper; defines SPELLBOOK_* vars
AGENT_USER="${SPELLBOOK_AGENT_USER:-}"
HUMAN_USER="${SPELLBOOK_HUMAN_USER:-}"
[ -n "$AGENT_USER" ] || die "install.env has no SPELLBOOK_AGENT_USER"
[ -n "$HUMAN_USER" ] || die "install.env has no SPELLBOOK_HUMAN_USER"
[ -n "${SPELLBOOK_RELEASE_KEY_FPR:-}" ] \
  || die "install.env has no SPELLBOOK_RELEASE_KEY_FPR — no signed-release trust anchor; human must set it (run install.sh once with SPELLBOOK_RELEASE_KEY_FPR=...)"

NO_SAGE_FLAG=""
[ "${SPELLBOOK_NO_SAGE:-0}" = "1" ] && NO_SAGE_FLAG="--no-sage"

echo "[spellbook-upgrade] upgrading ${INSTALLED} -> ${TAG} (keys/config/ledger untouched)"
# shellcheck disable=SC2086
exec env "SPELLBOOK_RELEASE_KEY_FPR=${SPELLBOOK_RELEASE_KEY_FPR}" \
  bash "$INSTALLER" --upgrade "$TAG" \
  --agent-user "$AGENT_USER" --human-user "$HUMAN_USER" $NO_SAGE_FLAG
