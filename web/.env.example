# Public relay URL baked in at build time (Vercel: set as Environment Variable).
# The tester can also override it in the page; the page value wins.
NEXT_PUBLIC_RELAY_URL=https://your-relay.up.railway.app

# NOTE: there is intentionally NO token here. The bearer token is pasted
# into the page by the tester and kept in browser localStorage only.
# Never commit a real token.
